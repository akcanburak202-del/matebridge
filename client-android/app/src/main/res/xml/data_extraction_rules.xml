<?xml version="1.0" encoding="utf-8"?>
<!--
  T-154: keep all app data on this tablet (Android 12+ / targetSdk 31+).
  allowBackup="false" no longer blocks device-to-device transfer for targetSdk >= 31,
  so both cloud backup and device transfer explicitly exclude every domain. This covers
  the shared preferences "matebridge" (settings, device_id), "matebridge_pairkeys" and
  "matebridge_audio", plus any future preference, database or file.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<dev.matebridge.client.input.PreImeFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:defaultFocusHighlightEnabled="false">

    <!-- T-246: outside touch mode (after a key, mouse or gamepad event) Android 8+ draws its default focus highlight
         over the focused view. On the full-screen video SurfaceView that is a ~6% white veil composited on top of the
         stream (black lifted to 16). Disabled here on every full-screen focusable view; focusability itself is
         unchanged (pointer capture and key events still need the focused video view). -->

    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:defaultFocusHighlightEnabled="false" />

    <TextView
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="#99000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="#66FF66"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Connect panel (shown until the stream starts). T-352: quiet layout, one big "Bağlan"/"Durdur"; T-362: path choice above it,
         the Tailscale address and settings are text buttons below it. The shared settings controls (T-105) are built into panel_settings from code,
         the same builder the in-stream side panel uses; they open under "Ayarlar". -->
    <ScrollView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mb_surface"
        android:defaultFocusHighlightEnabled="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/panel_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/mb_space_4">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mb_space_1"
                android:text="@string/app_name"
                android:textColor="@color/mb_text"
                android:textSize="@dimen/mb_text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mb_space_1"
                android:gravity="center"
                android:textColor="@color/mb_text_secondary"
                android:textSize="@dimen/mb_text_label" />

            <!-- T-362 (decision 0042): "Yerel ağ | Tailscale" segments and the "Veri tasarrufu" switch, built from code. -->
            <LinearLayout
                android:id="@+id/path_container"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mb_space_3"
                android:orientation="vertical" />

            <!-- T-078 / T-339: the Tailscale address field, hidden and disabled by default. A focused/visible editable field
                 makes Huawei HiWrite put a touchable handwriting window over the top centre of the screen, which then swallows
                 pen input while streaming. Opened only via "Tailscale adresi" (or by "Bağlan" without an address). -->
            <EditText
                android:id="@+id/remote_endpoint"
                style="@style/MbField"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mb_space_2"
                android:enabled="false"
                android:hint="@string/remote_endpoint_hint"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:singleLine="true"
                android:visibility="gone" />

            <Button
                android:id="@+id/connect"
                style="@style/MbButtonPrimary"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mb_space_3"
                android:text="@string/connect" />

            <!-- T-129: shown only when the host's Wake-on-LAN addresses are stored -->
            <Button
                android:id="@+id/wake"
                style="@style/MbButtonText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mb_space_1"
                android:text="@string/wol_button"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mb_space_2"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/remote_edit"
                    style="@style/MbButtonText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remote_edit"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/settings_toggle"
                    style="@style/MbButtonText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ayarlar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panel_settings"
                android:layout_width="@dimen/mb_settings_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mb_space_1"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</dev.matebridge.client.input.PreImeFrameLayout>

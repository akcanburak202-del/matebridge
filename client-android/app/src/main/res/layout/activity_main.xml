<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:defaultFocusHighlightEnabled="false">

    <!-- T-246: outside touch mode (after a key, mouse or gamepad event) Android 8+ draws its default focus highlight
         over the focused view. On the full-screen video SurfaceView that is a ~6% white veil composited on top of the
         stream (black lifted to 16). Disabled here on every full-screen focusable view; focusability itself is
         unchanged (pointer capture and key events still need the focused video view). -->

    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:defaultFocusHighlightEnabled="false" />

    <TextView
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="#99000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="#66FF66"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Connect panel (shown until the stream starts). Scrollable: the shared settings controls (T-105) are built into
         panel_settings from code, the same builder the in-stream side panel uses. -->
    <ScrollView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:defaultFocusHighlightEnabled="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/panel_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <!-- T-078: hidden and disabled by default. A focused/visible editable field makes Huawei HiWrite put a
                 touchable handwriting window over the top centre of the screen, which then swallows pen input
                 while streaming. Opened only via the "Manuel adres" button below. -->
            <EditText
                android:id="@+id/endpoint"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:enabled="false"
                android:hint="@string/endpoint_hint"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:visibility="gone" />

            <Button
                android:id="@+id/connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/connect" />

            <!-- T-129: shown only when the host's Wake-on-LAN addresses are stored -->
            <Button
                android:id="@+id/wake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wol_button"
                android:visibility="gone" />

            <!-- T-339 (decision 0038): the remote address field, hidden and disabled by default for the same HiWrite reason as
                 the manual address field above. Opened by "Uzak adres" (or by the first "Uzaktan bağlan"). -->
            <EditText
                android:id="@+id/remote_endpoint"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:enabled="false"
                android:hint="@string/remote_endpoint_hint"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:visibility="gone" />

            <Button
                android:id="@+id/remote_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/remote_connect" />

            <Button
                android:id="@+id/remote_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/remote_edit" />

            <Button
                android:id="@+id/endpoint_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Manuel adres" />

            <LinearLayout
                android:id="@+id/panel_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- T-352: the one big action on the connect screen. -->
    <style name="MbButtonPrimary" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/mb_button_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/mb_on_accent</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- Secondary actions: text only, no fill. -->
    <style name="MbButtonText" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/mb_button_text</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/mb_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/mb_control_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="MbField">
        <item name="android:background">@drawable/mb_field</item>
        <item name="android:textColor">@color/mb_text</item>
        <item name="android:textColorHint">@color/mb_text_secondary</item>
        <item name="android:textSize">@dimen/mb_text_label</item>
        <item name="android:minHeight">@dimen/mb_control_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>

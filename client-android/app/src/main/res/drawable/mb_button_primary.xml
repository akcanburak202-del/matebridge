<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mb_accent" />
            <stroke android:width="2dp" android:color="@color/mb_focus" />
            <corners android:radius="@dimen/mb_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mb_accent_pressed" />
            <corners android:radius="@dimen/mb_radius" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/mb_outline" />
            <corners android:radius="@dimen/mb_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mb_accent" />
            <corners android:radius="@dimen/mb_radius" />
        </shape>
    </item>
</selector>

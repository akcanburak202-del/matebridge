<?xml version="1.0" encoding="utf-8"?>
<!-- T-131: adaptive icon background. Vertical gradient #121820 -> #050608 spanning the
     visible 72 dp tile (y 18..90 of the 108 dp canvas), clamped outside it.
     Master geometry: docs/design/icon-master.svg -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="90"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#FF121820" />
                <item android:offset="1" android:color="#FF050608" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

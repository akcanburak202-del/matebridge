<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- T-355 (decision 0040): the tablet camera as a Mac webcam; asked at runtime when "Kamera: Otomatik" is first chosen -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <!-- T-135 (decision 0015): the tablet-files WebDAV server serves the shared storage; "all files access" -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- T-154: allowBackup="false" governs API 29/30 (cloud, D2D, adb); on API 31+ it no longer
         blocks device-to-device transfer, so dataExtractionRules excludes all data there.
         No fullBackupContent: allowBackup="false" already covers pre-12 devices. -->
    <application
        android:label="MateBridge"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- T-360 (decision 0041): "Kumandayla 120 Hz"; the service only dispatches a held gesture, it reads nothing. -->
        <service
            android:name=".input.HoldTouchService"
            android:exported="false"
            android:label="MateBridge 120 Hz"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hold_touch_service" />
        </service>
        <!-- T-301 (decision 0037): lets the non-debuggable daily build be profiled from the shell (simpleperf). -->
        <profileable android:shell="true" />
        <!-- T-185: the T-090 NetBenchActivity is declared in src/debug/AndroidManifest.xml (debug source set only). -->
    </application>
</manifest>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/bundle-host.sh fills CFBundleExecutable, CFBundleIdentifier, CFBundleName, CFBundleVersion and MBGitCommit. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>__EXECUTABLE__</string>
	<key>CFBundleIdentifier</key>
	<string>__BUNDLE_ID__</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>__NAME__</string>
	<key>CFBundleDisplayName</key>
	<string>__NAME__</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<!-- Short git commit of the build, "-dirty" for an unclean tree, "unknown" without git (T-145). -->
	<key>MBGitCommit</key>
	<string>__GIT_COMMIT__</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<!-- Menu bar app: no Dock icon. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MateBridge streams the screen to your tablet and receives its pen and keyboard input over the local network.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>MateBridge, Mac'in sesini tabletinizde çalmak için sistem sesini kaydeder.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_matebridge._tcp</string>
	</array>
</dict>
</plist>
